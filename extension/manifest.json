{
  "manifest_version": 3,
  "name": "AEGISX Sentinel — Cyber Evidence & Investigation SOC",
  "version": "1.0.0",
  "description": "Cyber defense telemetry, tamper-evident cryptographic ledger, and AI-assisted investigation dashboard for AEGISX Sentinel.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AEGISX Sentinel SOC Dashboard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
